{
  "key": "com.instana.plugin.zhmc",
  "name": "IBM Z HMC",
  "category": "Betriebssysteme & Mainframe",
  "docs": "https://www.ibm.com/docs/SSE1JP5_current/src/pages/ecosystem/zHMC/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "remote",
      "type": "objectList",
      "description": "HMC-Verbindungen",
      "fields": [
        {
          "key": "host",
          "type": "string",
          "description": "IP-Adresse der HMC"
        },
        {
          "key": "port",
          "type": "string",
          "description": "Port",
          "placeholder": "6794"
        },
        {
          "key": "user",
          "type": "string",
          "description": "HMC-Benutzer"
        },
        {
          "key": "password",
          "type": "secret",
          "description": "Passwort"
        },
        {
          "key": "poll_rate",
          "type": "integer",
          "description": "Metrik-Intervall (min. 15)",
          "unit": "s"
        },
        {
          "key": "eventsPollRate",
          "type": "integer",
          "description": "Event-Intervall (optional)",
          "unit": "s"
        },
        {
          "key": "connectionTimeout",
          "type": "integer",
          "description": "Verbindungsaufbau",
          "default": 50,
          "unit": "s"
        },
        {
          "key": "connectionRequestTimeout",
          "type": "integer",
          "description": "Verbindung aus dem Pool holen",
          "default": 50,
          "unit": "s"
        },
        {
          "key": "socketTimeout",
          "type": "integer",
          "description": "Socket-Read-Timeout",
          "default": 50,
          "unit": "s"
        }
      ]
    }
  ]
}
