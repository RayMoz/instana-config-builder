{
  "key": "com.instana.plugin.couchbase",
  "name": "Couchbase",
  "category": "Datenbanken",
  "docs": "https://www.ibm.com/docs/en/SSE1JP5/src/pages/ecosystem/couchbase/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "enabled",
      "type": "boolean",
      "description": "Sensor ein- oder ausschalten",
      "default": true
    },
    {
      "key": "user",
      "type": "string",
      "description": "Benutzer"
    },
    {
      "key": "password",
      "type": "secret",
      "description": "Passwort"
    },
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall",
      "default": 1,
      "unit": "s"
    }
  ]
}
