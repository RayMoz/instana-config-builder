{
  "key": "com.instana.plugin.websphere",
  "name": "WebSphere Application Server",
  "category": "Applikationsserver",
  "docs": "https://www.ibm.com/docs/SSE1JP5_current/src/pages/ecosystem/websphere-as/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "username",
      "type": "string",
      "description": "Admin-Benutzer (bei aktivierter Administrative Security)"
    },
    {
      "key": "password",
      "type": "secret",
      "description": "Passwort"
    },
    {
      "key": "enable_pmi",
      "type": "boolean",
      "description": "PMI aktivieren; der Agent passt die PMI-Einstellung an",
      "default": true
    },
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall",
      "unit": "s"
    }
  ]
}
