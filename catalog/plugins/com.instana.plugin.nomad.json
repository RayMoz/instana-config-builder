{
  "key": "com.instana.plugin.nomad",
  "name": "HashiCorp Nomad",
  "category": "Container & Orchestrierung",
  "docs": "https://www.ibm.com/docs/en/SSE1JP5/src/pages/ecosystem/nomad/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall (1–3600)",
      "default": 5,
      "unit": "s"
    },
    {
      "key": "caCertificate",
      "type": "string",
      "description": "Pfad zum CA-Zertifikat (PEM)"
    },
    {
      "key": "clientCertificate",
      "type": "string",
      "description": "Pfad zum Client-Zertifikat (PEM)"
    },
    {
      "key": "clientKey",
      "type": "string",
      "description": "Pfad zum Client-Schlüssel (PEM)"
    }
  ]
}
