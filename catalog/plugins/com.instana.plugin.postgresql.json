{
  "key": "com.instana.plugin.postgresql",
  "name": "PostgreSQL",
  "category": "Datenbanken",
  "docs": "https://www.ibm.com/docs/SSE1JP5/src/pages/ecosystem/postgresql/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "user",
      "type": "string",
      "description": "Benutzer für die Sensor-Anmeldung"
    },
    {
      "key": "password",
      "type": "secret",
      "description": "Passwort des Benutzers"
    },
    {
      "key": "database",
      "type": "string",
      "description": "Datenbank für die Anmeldung (Standard: gleich dem Benutzernamen)"
    },
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall in Sekunden",
      "default": 1,
      "unit": "s"
    },
    {
      "key": "isRootlessPodman",
      "type": "boolean",
      "description": "Nur setzen, wenn PostgreSQL in rootless Podman läuft",
      "default": false
    }
  ]
}
