{
  "key": "com.instana.plugin.clickhouse",
  "name": "ClickHouse",
  "category": "Datenbanken",
  "docs": "https://www.ibm.com/docs/SSE1JP5_current/src/pages/ecosystem/clickhouse/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "enabled",
      "type": "boolean",
      "description": "Sensor ein/aus"
    },
    {
      "key": "user",
      "type": "string",
      "description": "Benutzer (HTTP-Interface)"
    },
    {
      "key": "password",
      "type": "secret",
      "description": "Passwort"
    },
    {
      "key": "protocol",
      "type": "enum",
      "description": "Protokoll",
      "options": ["http", "https"]
    },
    {
      "key": "host",
      "type": "string",
      "description": "Host/IP"
    },
    {
      "key": "httpPort",
      "type": "integer",
      "description": "HTTP-Port",
      "placeholder": "8123"
    },
    {
      "key": "clusterName",
      "type": "string",
      "description": "Zu überwachender Cluster"
    },
    {
      "key": "monitorTables",
      "type": "stringList",
      "description": "Tabellen mit Detailmetriken",
      "placeholder": "db.table"
    },
    {
      "key": "tracingEnabled",
      "type": "boolean",
      "description": "Tracing ein/aus"
    },
    {
      "key": "profilingEnabled",
      "type": "boolean",
      "description": "Profiling ein/aus"
    },
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall",
      "default": 5,
      "unit": "s"
    }
  ]
}
