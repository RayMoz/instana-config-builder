{
  "key": "com.instana.plugin.redis",
  "name": "Redis",
  "category": "Datenbanken",
  "docs": "https://www.ibm.com/docs/SSE1JP5_current/src/pages/ecosystem/redis/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "username",
      "type": "string",
      "description": "ACL-Benutzer (Redis 6+)"
    },
    {
      "key": "password",
      "type": "secret",
      "description": "Passwort"
    },
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall",
      "default": 1,
      "unit": "s"
    },
    {
      "key": "config-command",
      "type": "string",
      "description": "Umbenanntes CONFIG-Kommando (rename-command)",
      "placeholder": "CONFIG"
    },
    {
      "key": "monitor",
      "type": "objectList",
      "description": "Einzelne Werte überwachen",
      "fields": [
        {
          "key": "db",
          "type": "integer",
          "description": "Datenbanknummer",
          "default": 0
        },
        {
          "key": "key",
          "type": "string",
          "description": "Schlüssel"
        },
        {
          "key": "type",
          "type": "enum",
          "description": "Metriktyp",
          "options": ["list-length"]
        }
      ]
    }
  ]
}
