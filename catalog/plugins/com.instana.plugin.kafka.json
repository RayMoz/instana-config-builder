{
  "key": "com.instana.plugin.kafka",
  "name": "Kafka",
  "category": "Messaging",
  "docs": "https://www.ibm.com/docs/SSE1JP5_current/src/pages/ecosystem/kafka/index.html",
  "source": "ibm-docs",
  "fields": [
    {
      "key": "poll_rate",
      "type": "integer",
      "description": "Abfrageintervall",
      "default": 1,
      "unit": "s"
    },
    {
      "key": "topicsRegex",
      "type": "string",
      "description": "Regex für bis zu 400 Topics (Standard: die ersten 400 nach Name)"
    },
    {
      "key": "brokerPropertiesFilePath",
      "type": "string",
      "description": "Pfad zur server.properties des Brokers",
      "placeholder": "/path/to/server.properties"
    },
    {
      "key": "controllerPropertiesFilePath",
      "type": "string",
      "description": "KRaft-Controller-Properties (optional)",
      "placeholder": "/path/to/controller.properties"
    },
    {
      "key": "collectLagData",
      "type": "boolean",
      "description": "Consumer-Lag erfassen",
      "default": true
    },
    {
      "key": "sslTrustStore",
      "type": "string",
      "description": "Pfad zum Truststore"
    },
    {
      "key": "sslTrustStorePassword",
      "type": "secret",
      "description": "Passwort des Truststores"
    },
    {
      "key": "sslKeyStore",
      "type": "string",
      "description": "Pfad zum Keystore"
    },
    {
      "key": "sslKeyStorePassword",
      "type": "secret",
      "description": "Passwort des Keystores"
    },
    {
      "key": "saslUsername",
      "type": "string",
      "description": "SASL/PLAIN-Benutzer"
    },
    {
      "key": "saslPassword",
      "type": "secret",
      "description": "SASL/PLAIN-Passwort"
    },
    {
      "key": "jmxUsername",
      "type": "string",
      "description": "JMX-Benutzer"
    },
    {
      "key": "jmxPassword",
      "type": "secret",
      "description": "JMX-Passwort"
    },
    {
      "key": "jmxPort",
      "type": "string",
      "description": "JMX-Port",
      "default": "1099"
    }
  ]
}
